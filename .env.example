# TFT Insight - configuração local
# Copie este arquivo para .env e preencha apenas localmente.

RIOT_API_KEY=sua_chave_aqui

# Narrador local opcional
TFT_INSIGHT_LOCAL_AI_ENABLED=false
TFT_INSIGHT_LOCAL_AI_MODEL=llama3.2:3b
TFT_INSIGHT_OLLAMA_URL=http://localhost:11434
TFT_INSIGHT_LOCAL_AI_TIMEOUT=45

# Autenticação do portal
TFT_INSIGHT_AUTH_ENABLED=true
TFT_INSIGHT_AUTH_SECRET=troque_por_um_segredo_aleatorio_com_pelo_menos_32_caracteres
TFT_INSIGHT_AUTH_TOKEN_MINUTES=720
TFT_INSIGHT_ADMIN_EMAIL=seu_email_aqui

# URL usada pelo Streamlit para falar com a API local
TFT_INSIGHT_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth entra na etapa 26.1D
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Persistência PostgreSQL
# Em produção, use a URL privada/interna fornecida pelo provedor quando disponível.
DATABASE_URL=postgresql://usuario:senha@host:5432/tft_insight

# Runtime da API
HOST=0.0.0.0
PORT=8000
TFT_INSIGHT_ENVIRONMENT=Development
